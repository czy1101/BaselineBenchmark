ninja_required_version = 1.3

rule hgcc_compile
  command = /usr/local/PPU_SDK/bin/hgcc -O3 -std=c++17 --expt-relaxed-constexpr --expt-extended-lambda --use_fast_math -lineinfo -mllvm -ppu-patch-fence-ppu=false -mllvm -wno-loop-miss-transform -mllvm -ppu-cg-to-kp1=true -mllvm -ppu-fix-uninit=true -mllvm -ppu-force-warpage=true -mllvm -sort-copy-before-coalesce=true -mllvm -ppu-eliminate-early-v2s=true -mllvm -ppu-pref-fma-reuse=true --threads 16 -arch=ppu_10 -arch=ppu_15 -Xcompiler -fPIC -U__HGGC_NO_HALF_OPERATORS__ -U__HGGC_NO_HALF_CONVERSIONS__ -U__HGGC_NO_HALF2_OPERATORS__ -U__HGGC_NO_BFLOAT16_CONVERSIONS__ -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=1 -I/workspace/pla/src -I/workspace/pla/src/decode/k-last -I/usr/local/lib/python3.12/site-packages/torch/include -I/usr/local/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/usr/local/include/python3.12 -I/usr/local/PPU_SDK/targets/x86_64-linux/include -I/usr/local/PPU_SDK/CUDA_SDK/targets/x86_64-linux/include -c $in -o $out
  description = HGCC $in

rule cxx_compile
  command = c++ -O3 -std=c++17 -fPIC -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=1 -I/workspace/pla/src -I/workspace/pla/src/decode/k-last -I/usr/local/lib/python3.12/site-packages/torch/include -I/usr/local/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/usr/local/include/python3.12 -I/usr/local/PPU_SDK/targets/x86_64-linux/include -I/usr/local/PPU_SDK/CUDA_SDK/targets/x86_64-linux/include -c $in -o $out
  description = CXX $in

build /workspace/pla/build/temp.linux-x86_64-cpython-312/pla.decode._C/fused_sigmoid_gating_698eb589517f.o: cxx_compile /workspace/pla/src/decode/k-last/fused_sigmoid_gating.cpp
